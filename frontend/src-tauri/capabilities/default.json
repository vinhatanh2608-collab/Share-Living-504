{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-main",
  "description": "Main window API, private object storage, and desktop notifications. Add only the deployed HTTPS origins when packaging a remote build.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-message",
    {
      "identifier": "http:default",
      "allow": [
        {"url":"http://localhost:8000/**"},{"url":"http://127.0.0.1:8000/**"},
        {"url":"http://localhost:9000/**"},{"url":"http://127.0.0.1:9000/**"},
        {"url":"https://*.r2.cloudflarestorage.com/**"}
      ]
    },
    {
      "identifier":"opener:allow-open-url",
      "allow":[
        {"url":"http://localhost:9000/**"},{"url":"http://127.0.0.1:9000/**"},
        {"url":"https://*.r2.cloudflarestorage.com/**"}
      ]
    }
  ]
}
