{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shared Living",
  "version": "2.0.0",
  "identifier": "vn.sharedliving.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Shared Living","width":1200,"height":800,"minWidth":800,"minHeight":600,"useHttpsScheme":true}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' blob: https://img.vietqr.io; style-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["desktop-main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type": "offlineInstaller"},
      "nsis": {"installMode": "currentUser"},
      "wix": {"language": "en-US"}
    }
  }
}
