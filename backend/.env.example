# Fill in unique credentials before starting the development stack.
# Generate a JWT key with: python -c "import secrets; print(secrets.token_hex(32))"
ENVIRONMENT=development
MYSQL_URL=mysql+aiomysql://dorm:<url-encoded-mysql-password>@127.0.0.1:3306/dorm?charset=utf8mb4
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MONGO_URL=mongodb://dormadmin:<url-encoded-mongo-password>@127.0.0.1:27017/?authSource=admin
MONGO_DATABASE=dorm
MONGO_INITDB_ROOT_USERNAME=dormadmin
MONGO_INITDB_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=dorm
S3_ACCESS_KEY=
S3_SECRET_KEY=
JWT_SECRET=
OWNER_USERNAME=zin
CORS_ORIGINS=["http://localhost:1420","http://127.0.0.1:1420","tauri://localhost","http://tauri.localhost","https://tauri.localhost"]
LEGACY_ROOM=false
# The advisor runs locally without credentials. For a provider, set GEMINI_API_KEY
# and optionally GEMINI_MODEL, or set LLM_BASE_URL, LLM_API_KEY, and LLM_MODEL.
